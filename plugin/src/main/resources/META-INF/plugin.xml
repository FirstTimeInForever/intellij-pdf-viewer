<idea-plugin package="com.firsttimeinforever.intellij.pdf.viewer" require-restart="true">
  <id>com.firsttimeinforever.intellij.pdf.viewer.intellij-pdf-viewer</id>
  <name>PDF Viewer</name>
  <vendor email="ivmposti+pdf-viewer@gmail.com" url="https://github.com/FirstTimeInForever/intellij-pdf-viewer">
    FirstTimeInForever
  </vendor>

  <content>
    <module name="com.firsttimeinforever.intellij.pdf.viewer.common" />
    <module name="com.firsttimeinforever.intellij.pdf.viewer.backend" required-if-available="intellij.platform.backend"/>
    <module name="com.firsttimeinforever.intellij.pdf.viewer.frontend" required-if-available="intellij.platform.frontend"/>
  </content>

</idea-plugin>
